# ============================================================
# AI Ops 实验室 · 供应商 Key 配置模板
# ------------------------------------------------------------
# 用法：cp .env.example .env  然后在 .env 里填真实 Key。
# .env 已被 .gitignore 覆盖，严禁明文入库（提交前 grep 复查）。
# 6 家云端 + 1 档本地（LM Studio），对应原型 2 的混合路由拓扑。
# ============================================================

# ---- 腾讯混元（腾讯云 OpenAPI，密钥在控制台「访问管理 CAM」）----
TENCENT_SECRET_ID=your_tencent_secret_id_here
TENCENT_SECRET_KEY=your_tencent_secret_key_here

# ---- 阿里百炼 / Qwen（DashScope，OpenAI 兼容端点）----
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---- 字节豆包（火山引擎 Ark，OpenAI 兼容端点）----
ARK_API_KEY=your_volcengine_ark_api_key_here

# ---- 小米（OpenAI 兼容端点，OpenRouter 全球前十模型所在）----
XIAOMI_API_KEY=your_xiaomi_api_key_here

# ---- 智谱 GLM（OpenAI 兼容端点）----
ZHIPU_API_KEY=your_zhipu_api_key_here

# ---- DeepSeek（OpenAI 兼容端点）----
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---- 本地档：LM Studio（无 Key，占位保持结构统一）----
# 端点默认 http://localhost:1234/v1，模型 Qwen3.5-9B（D:\AI-Models）
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio

# ---- 原型 1 靶场（Prometheus，159 为主靶场）----
PROMETHEUS_URL=http://192.168.1.160:9091
ALERTMANAGER_WEBHOOK_SECRET=your_webhook_signing_secret_here
